#include <windows.h>
#include "resource.h"
#include "version.h"

#pragma code_page(65001)

1 RT_MANIFEST "panel.manifest"
IDI_APP_ICON ICON "assets\\icon.ico"
IDI_TRAY_ICON ICON "assets\\icon-tray.ico"

IDD_STATS_DATE_RANGE DIALOGEX 0, 0, 204, 96
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "自选日期"
FONT 9, "Microsoft YaHei UI"
BEGIN
    LTEXT "开始日期", -1, 12, 13, 58, 12
    CONTROL "", ID_DATE_FROM, "SysDateTimePick32", WS_TABSTOP, 72, 10, 120, 16
    LTEXT "结束日期", -1, 12, 37, 58, 12
    CONTROL "", ID_DATE_TO, "SysDateTimePick32", WS_TABSTOP, 72, 34, 120, 16
    DEFPUSHBUTTON "查看", IDOK, 76, 69, 54, 16
    PUSHBUTTON "取消", IDCANCEL, 138, 69, 54, 16
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION PANEL_VER_MAJOR,PANEL_VER_MINOR,PANEL_VER_PATCH,0
 PRODUCTVERSION PANEL_VER_MAJOR,PANEL_VER_MINOR,PANEL_VER_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Gravity Steward\0"
            VALUE "FileDescription", "Gravity Steward for Antigravity\0"
            VALUE "FileVersion", PANEL_VERSION_UTF8 ".0\0"
            VALUE "InternalName", "CodexApprovalPanel\0"
            VALUE "OriginalFilename", "CodexApprovalPanel.exe\0"
            VALUE "ProductName", "Gravity Steward\0"
            VALUE "ProductVersion", PANEL_VERSION_UTF8 ".0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
