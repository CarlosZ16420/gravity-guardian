+/// External assessment only: no execution or live approval publication.
+pub(crate) async fn assess_external_guardian(
+    session: Arc<Session>,
+    items: Vec<codex_protocol::models::ResponseItem>,
+    action: codex_protocol::models::ResponseItem,
+    host_facts: serde_json::Value,
+    authorization: serde_json::Value,
+    timeout_ms: u64,
+    cancellation: CancellationToken,
+) -> anyhow::Result<serde_json::Value> {
+    crate::client::take_external_guardian_diagnostics();
+    crate::client::set_external_guardian_action_too_large(false);
+    crate::client::set_external_guardian_authorization_too_large(false);
+    let start = std::time::Instant::now();
+    let deadline = ReviewDeadline::from_timeout(Some(Duration::from_millis(timeout_ms)));
+    crate::client::begin_external_guardian_measurement(host_facts, authorization);
+    let turn = session.new_default_turn().await;
+    session.record_conversation_items(&turn, turn.model_info(), &items).await;
+    let request = GuardianApprovalRequest::NativeToolCall {
+        id: uuid::Uuid::new_v4().to_string(), call: Box::new(action),
+    };
+    let context = GuardianReviewContext::from(&turn);
+    let (outcome, analytics, _) = run_with_retry(
+        GuardianReviewSessionLimits { max_attempts: codex_guardian_reviewer::MAX_REVIEW_ATTEMPTS, deadline },
+        Some(&cancellation), None, |deadline| {
+            let attempt = run_guardian_review_session_before_deadline(
+                Arc::clone(&session), context.clone(), request.clone(), request.guardian_scope(),
+                ApprovalRequestReasons::default(),
+                ReviewAttemptOptions { authorization: None, external_cancel: Some(cancellation.clone()), deadline },
+            );
+            async move {
+                let (outcome, analytics) = attempt.await;
+                if let GuardianReviewOutcome::Error(error) = &outcome {
+                    crate::client::record_external_guardian_diagnostic(serde_json::json!({
+                        "event": "guardian_attempt_failed", "failure": external_failure(error),
+                        "usage": analytics.token_usage,
+                    }));
+                }
+                (outcome, analytics, None::<()>)
+            }
+        },
+    ).await;
+    let inference_requests = crate::client::end_external_guardian_measurement();
+    let sampling = crate::client::take_external_guardian_diagnostics();
+    let assessment = match outcome {
+        GuardianReviewOutcome::Completed(value) => serde_json::to_value(value)?,
+        outcome => {
+            let failure = if crate::client::external_guardian_action_too_large() {
+                serde_json::json!({"reasonCode":"native_action_budget_exceeded","rawErrorKind":"action_input_budget","retryable":false})
+            } else if crate::client::external_guardian_authorization_too_large() {
+                serde_json::json!({"reasonCode":"review_authorization_budget_exceeded","rawErrorKind":"authorization_budget","retryable":false})
+            } else { match &outcome {
+                GuardianReviewOutcome::Error(error) => external_failure(error),
+                _ => serde_json::json!({"reasonCode":"adapter_incompatible","rawErrorKind":"unexpected_cached_approval","retryable":false}),
+            }};
+            return Ok(serde_json::json!({
+                "error": "Native Guardian did not produce an assessment",
+                "failure": failure, "attemptCount": analytics.attempt_count,
+                "inferenceDispatchCount": inference_requests, "httpRequestCount": null,
+                "usage": analytics.token_usage, "sampling": sampling,
+            }));
+        }
+    };
+    Ok(serde_json::json!({ "assessment":assessment, "usage":analytics.token_usage,
+        "elapsedMs":start.elapsed().as_millis(), "guardianThreadId":analytics.guardian_thread_id,
+        "sessionKind":format!("{:?}",analytics.guardian_session_kind), "contextMode":analytics.guardian_context_mode,
+        "model":analytics.guardian_model,"effort":analytics.guardian_reasoning_effort,
+        "inferenceDispatchCount":inference_requests,"attemptCount":analytics.attempt_count,"httpRequestCount":null,
+        "sampling":sampling,"actionExecuted":false,"approvalPublished":false }))
+}
+
+fn external_failure(error: &GuardianReviewError) -> serde_json::Value {
+    use codex_protocol::protocol::CodexErrorInfo as Info;
+    use GuardianReviewError as Error;
+    let (code, kind, status, retryable, retry_after) = match error {
+        Error::Session { message, .. } if message.contains("account changed while preparing model request") =>
+            ("action_invalidated", serde_json::json!("review_account_changed"), None, false, None),
+        Error::Session { error_info, retry_at, .. } => {
+            let retry_after = retry_at.map(|at| at.saturating_duration_since(Instant::now()).as_millis() as u64);
+            let (code, status, retryable) = match error_info {
+                Some(Info::UsageLimitExceeded) => ("quota_exhausted", None, false),
+                Some(Info::RateLimitExceeded) => ("rate_limited", Some(429), true),
+                Some(Info::Unauthorized | Info::ModelNotFound) => ("entitlement_unavailable", None, false),
+                Some(Info::CyberPolicy | Info::BioPolicy | Info::MisalignmentPolicyViolation) =>
+                    ("upstream_policy_blocked", None, false),
+                Some(Info::HttpConnectionFailed { http_status_code }
+                    | Info::ResponseStreamConnectionFailed { http_status_code }
+                    | Info::ResponseStreamDisconnected { http_status_code }
+                    | Info::ResponseTooManyFailedAttempts { http_status_code }) => (
+                    if *http_status_code == Some(429) { "rate_limited" } else { "upstream_unavailable" },
+                    *http_status_code, matches!(http_status_code, None | Some(408 | 429 | 500..=599))),
+                Some(Info::FlexUnavailable | Info::ServerOverloaded | Info::PolicyCapacityUnavailable
+                    | Info::InternalServerError) => ("upstream_unavailable", None, true),
+                Some(Info::ContextWindowExceeded) => ("review_input_budget_exceeded", None, false),
+                _ => ("reviewer_unavailable", None, false),
+            };
+            (code, serde_json::json!(format!("{error_info:?}")), status, retryable, retry_after)
+        }
+        Error::Parse { .. } => ("assessment_invalid", serde_json::json!("parse"), None, true, None),
+        Error::Timeout => ("review_timeout", serde_json::json!("timeout"), None, false, None),
+        Error::Cancelled => ("review_cancelled", serde_json::json!("cancelled"), None, false, None),
+        Error::StaleAuthorization => ("action_invalidated", serde_json::json!("stale_authorization"), None, true, None),
+        Error::InputBudgetExceeded =>
+            ("review_input_budget_exceeded", serde_json::json!("input_budget"), None, false, None),
+        Error::PromptBuild { message } if message.contains("external_authorization") =>
+            ("review_authorization_budget_exceeded", serde_json::json!("authorization_budget"), None, false, None),
+        Error::PromptBuild { .. } =>
+            ("context_invalid", serde_json::json!(format!("{:?}", error.failure_reason())), None, false, None),
+    };
+    serde_json::json!({"reasonCode":code,"rawErrorKind":kind,"httpStatus":status,
+        "retryable":retryable,"retryAfterMs":retry_after})
+}
