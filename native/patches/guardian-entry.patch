+// Dedicated external host serializes assessments. Inactive in ordinary Codex processes.
+static EXTERNAL_GUARDIAN_DISPATCHES: std::sync::atomic::AtomicI64 = std::sync::atomic::AtomicI64::new(-1);
+static EXTERNAL_GUARDIAN_FACTS: std::sync::Mutex<Option<ResponseItem>> = std::sync::Mutex::new(None);
+static EXTERNAL_GUARDIAN_AUTHORIZATION: std::sync::Mutex<Option<ResponseItem>> = std::sync::Mutex::new(None);
+
+pub(crate) fn begin_external_guardian_measurement(host_facts: serde_json::Value, authorization: serde_json::Value) {
+    let facts = host_facts.as_object().filter(|facts| !facts.is_empty()).map(|_| ResponseItem::Message {
+        id: None,
+        status: None,
+        encrypted_content: None,
+        role: "assistant".to_owned(),
+        content: vec![codex_protocol::models::ContentItem::OutputText {
+            annotations: None,
+            logprobs: None,
+            text: format!("Host-observed Antigravity facts for the current action, not user authorization: {host_facts}"),
+        }],
+        phase: None,
+        internal_chat_message_metadata_passthrough: None,
+    });
+    *EXTERNAL_GUARDIAN_FACTS.lock().unwrap_or_else(|error| error.into_inner()) = facts;
+    *EXTERNAL_GUARDIAN_AUTHORIZATION.lock().unwrap_or_else(|error| error.into_inner()) = Some(ResponseItem::Message {
+        id: None,
+        status: None,
+        encrypted_content: None,
+        role: "user".to_owned(),
+        content: vec![codex_protocol::models::ContentItem::InputText {
+            text: format!("Antigravity authorization evidence (current request):\n{authorization}"),
+        }],
+        phase: None,
+        internal_chat_message_metadata_passthrough: None,
+    });
+    EXTERNAL_GUARDIAN_DISPATCHES.store(0, Ordering::SeqCst);
+}
+
+pub(crate) fn external_guardian_facts() -> Option<ResponseItem> {
+    if EXTERNAL_GUARDIAN_DISPATCHES.load(Ordering::SeqCst) < 0 {
+        return None;
+    }
+    EXTERNAL_GUARDIAN_FACTS.lock().unwrap_or_else(|error| error.into_inner()).clone()
+}
+
+pub(crate) fn end_external_guardian_measurement() -> i64 {
+    let dispatches = EXTERNAL_GUARDIAN_DISPATCHES.swap(-1, Ordering::SeqCst);
+    EXTERNAL_GUARDIAN_FACTS.lock().unwrap_or_else(|error| error.into_inner()).take();
+    EXTERNAL_GUARDIAN_AUTHORIZATION.lock().unwrap_or_else(|error| error.into_inner()).take();
+    dispatches
+}
+
+pub(crate) fn external_guardian_authorization() -> Option<ResponseItem> {
+    if EXTERNAL_GUARDIAN_DISPATCHES.load(Ordering::SeqCst) < 0 {
+        return None;
+    }
+    EXTERNAL_GUARDIAN_AUTHORIZATION.lock().unwrap_or_else(|error| error.into_inner()).clone()
+}
+static EXTERNAL_GUARDIAN_DIAGNOSTICS: std::sync::Mutex<Vec<serde_json::Value>> =
+    std::sync::Mutex::new(Vec::new());
+
+pub(crate) fn record_external_guardian_diagnostic(event: serde_json::Value) {
+    let mut events = EXTERNAL_GUARDIAN_DIAGNOSTICS.lock().unwrap_or_else(|error| error.into_inner());
+    if events.len() < 64 {
+        events.push(event);
+    }
+}
+
+pub(crate) fn take_external_guardian_diagnostics() -> Vec<serde_json::Value> {
+    std::mem::take(&mut *EXTERNAL_GUARDIAN_DIAGNOSTICS.lock().unwrap_or_else(|error| error.into_inner()))
+}
+
+static EXTERNAL_GUARDIAN_ACTION_TOO_LARGE: AtomicBool = AtomicBool::new(false);
+static EXTERNAL_GUARDIAN_AUTHORIZATION_TOO_LARGE: AtomicBool = AtomicBool::new(false);
+
+pub(crate) fn set_external_guardian_action_too_large(value: bool) {
+    EXTERNAL_GUARDIAN_ACTION_TOO_LARGE.store(value, Ordering::SeqCst);
+}
+
+pub(crate) fn external_guardian_action_too_large() -> bool {
+    EXTERNAL_GUARDIAN_ACTION_TOO_LARGE.load(Ordering::SeqCst)
+}
+
+pub(crate) fn set_external_guardian_authorization_too_large(value: bool) {
+    EXTERNAL_GUARDIAN_AUTHORIZATION_TOO_LARGE.store(value, Ordering::SeqCst);
+}
+
+pub(crate) fn external_guardian_authorization_too_large() -> bool {
+    EXTERNAL_GUARDIAN_AUTHORIZATION_TOO_LARGE.load(Ordering::SeqCst)
+}
